    "node": "hardhat node",
    "seed": "hardhat run scripts/seed_demo.js --network localhost",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build"
  },
  "keywords": [
    "soulbound-tokens",
    "eip-5192",
    "academic-credentials",
    "ipfs",
    "tamper-proof",
    "web3",
    "polygon"
  ],
