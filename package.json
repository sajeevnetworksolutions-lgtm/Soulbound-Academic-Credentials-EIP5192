{
  "name": "soulbound-academic-credentials",
  "version": "1.0.0",
  "description": "Decentralized Academic Credential Verification and Tamper-Proof Certificate Issuance Platform using Soulbound Tokens (EIP-5192) and IPFS",
  "main": "index.js",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
